# Copy to .env.local and fill in. Never commit .env.local.
# Create the key in Google AI Studio, in a project WITHOUT billing enabled.
GEMINI_API_KEY=

# Models are changed manually; any change re-opens the evaluation gate.
# Run `npm run list:models` and `npm run check:model -- --model=<id>` to see what your project can call.
# On 26 Oct 2026 a new project got 404 for gemini-2.5-flash and 503/504 for gemini-3.8-flash;
# gemini-3-flash-preview answered reliably. Its free tier allowed only 20 requests/day per model, so Extract
# runs on gemini-3.1-flash-lite (separate quota) and Judge on gemini-3-flash-preview.
WARRANTLAB_EXTRACT_MODEL=gemini-3.1-flash-lite
WARRANTLAB_JUDGE_MODEL=gemini-3-flash-preview

WARRANTLAB_MAX_WORDS=3000
WARRANTLAB_CAUSAL_ENABLED=false

# Local only: lets sections marked devPreview be selected before they pass the gate.
WARRANTLAB_DEV_PREVIEW=false
